# General
alias t="tmux"
alias h="cd ~"
alias cls="clear"
alias scs="sudo systemctl start"

# Edit Zsh config
alias aliasedit="$EDITOR ~/.aliases"
alias zshedit="$EDITOR ~/.zshrc"
alias envedit="$EDITOR ~/.zshenv"
alias omzedit="$EDITOR ~/.oh-my-zsh"

# Reload Zsh config
alias rezsh="source ~/.zshrc"

# Copy & paste
alias xc="xclip -selection clipboard"
alias xp="xclip -selection clipboard -o"

# Check current public IP address
alias myip="curl -s https://api.ipify.org"

# Ping Google
alias png="ping google.com"

# DNF
alias sd="sudo dnf"
alias sdi="sudo dnf install -y"
alias sdu="sudo dnf upgrade --refresh -y"

#NPM
alias ni="npm install"
alias nig="npm install -g"
alias nd="npm run dev"
alias nr="npm run"

#YARN
alias s="yarn start"
alias yb="yarn build"
alias yt="yarn test"
alias ya="yarn add"
alias yad="yarn add -D"
alias yag="yarn global add"
alias yr="yarn remove"
alias ydv="yarn dev"
alias yd="yarn deploy"

#PNPM
alias p="pnpm"
alias pd="pnpm dev"
alias pb="pnpm build"
alias ps="pnpm start"

# Open editor
e() {
  if [ -z $1 ]; then
    $DESKTOP_EDITOR .
  else
    $DESKTOP_EDITOR $1
  fi
}

c() {
  if [ -z $1 ]; then
    cursor --classic .
  else
    cursor --classic $1
  fi
}

zd() {
  if [ -z $1 ]; then
    zed .
  else
    zed $1
  fi
}

alias et="f -e $DESKTOP_EDITOR -d"

# Git
alias glo='git pull origin "$(git_current_branch)"'
alias gpo='git push origin "$(git_current_branch)"'
alias glf='git pull fork` "$(git_current_branch)"'
alias gpf='git push fork "$(git_current_branch)"'
