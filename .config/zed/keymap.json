// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-shift-k": "terminal_panel::Toggle",
      "cmd-ctrl-left": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" }
      ],
      "cmd-ctrl-right": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" }
      ]
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "AcpThread",
    "unbind": {
      "cmd-shift-g": "agent::SelectPreviousThreadMatch"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "unbind": {
      "ctrl-cmd-right": "editor::AcceptNextWordEditPrediction"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-cmd-right": "editor::SelectLargerSyntaxNode"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-backspace": "editor::DeleteLine"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-shift-k": "editor::DeleteLine"
    }
  },
  {
    "context": "Editor && multibuffer",
    "unbind": {
      "cmd-shift-up": "editor::SelectToStartOfExcerpt"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-up": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-up": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-down": "editor::MoveLineDown"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-cmd-left": "editor::SelectSmallerSyntaxNode"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-f12": "editor::GoToTypeDefinition"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-f12": "editor::GoToImplementation"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "shift-f12": "editor::GoToImplementation"
    }
  },
  {
    "context": "AcpThread",
    "bindings": {
      "ctrl-g": "agent::SelectNextThreadMatch"
    }
  },
  {
    "context": "AcpThread",
    "unbind": {
      "cmd-g": "agent::SelectNextThreadMatch"
    }
  },
  {
    "context": "ThreadsSidebar",
    "bindings": {
      "ctrl-g": "agents_sidebar::ToggleThreadHistory"
    }
  },
  {
    "context": "ThreadsSidebar",
    "unbind": {
      "cmd-g": "agents_sidebar::ToggleThreadHistory"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-g": "search::SelectNextMatch"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-g": "search::SelectNextMatch"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-g": "go_to_line::Toggle"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-g": "go_to_line::Toggle"
    }
  }
]
